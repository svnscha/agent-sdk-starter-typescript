# Fill ONE authentication method. Keep the other empty.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Docker Desktop reaches the Windows host at this name.
MCP_WINDBG_URL=http://host.docker.internal:8000/mcp/

# Windows path to the SAME folder mounted as /data/dumps in the container.
# Single quotes preserve Windows backslashes. Change this for your checkout.
DUMP_HOST_DIR='C:\path\to\mcp-windbg-claude-sdk-demo\dumps'

CLAUDE_MODEL=sonnet
