{
  "name": "claude-sdk-crash-triage-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "once": "npm start -- --once",
    "check:mcp": "node --env-file-if-exists=.env dist/check-mcp.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
